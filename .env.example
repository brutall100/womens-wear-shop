# Copy this file to .env and fill it in:  cp .env.example .env
# .env is private – it is listed in .gitignore and must never be committed.

# Admin password, stored as a hash (never as plain text).
# Create it with:  npm run hash-password -- "your-long-password"
# and paste the printed line here. With `npm run dev` and an empty value
# the development password "mot-admin" works; in production login stays locked.
ADMIN_PASSWORD_HASH=

# Secret used to sign the admin login cookie (at least 16 characters).
# Leave empty to let the app create one in data/auth-secret.
# Example way to make one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Public address of the shop without a trailing slash, e.g. https://shop.example.com
# The bank sends the buyer back here. Can stay empty on your own computer.
APP_URL=

# Where the SQLite database lives. Empty = data/mot.db
MOT_DB_PATH=
