# --- Duomenų bazė ---------------------------------------------------------
# Lokaliai naudojama SQLite. Produkcijai rekomenduojama PostgreSQL
# (prisma/schema.prisma -> datasource provider = "postgresql").
DATABASE_URL="file:./dev.db"

# --- Parduotuvė -----------------------------------------------------------
NEXT_PUBLIC_SHOP_NAME="Mūza"
# Viešas parduotuvės adresas (be pasvirojo brūkšnio gale). Į jį SEB grąžina
# pirkėją po apmokėjimo, todėl turi būti tikras domenas (ne localhost).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Pristatymo kainos centais
SHIPPING_COURIER_CENTS=499
SHIPPING_PARCEL_LOCKER_CENTS=299
# Nuo kokios sumos (centais) pristatymas nemokamas. 0 = niekada.
FREE_SHIPPING_FROM_CENTS=10000

# --- Admin panelė ---------------------------------------------------------
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="pakeisk-mane"
# Ilgas atsitiktinis raktas sesijos slapukams pasirašyti (>= 32 simboliai)
AUTH_SECRET="pakeisk-mane-i-ilga-atsitiktine-eilute"
# Kur saugomos įkeltos nuotraukos (santykinis nuo projekto šaknies arba absoliutus)
UPLOAD_DIR="./uploads"

# --- SEB e. prekyba (EveryPay mokėjimų vartai) ----------------------------
# Duomenys iš SEB prekybininko portalo -> Settings -> General settings.
# Kol SEB_API_USERNAME nenurodytas, parduotuvė veikia DEMO režimu:
# vietoje banko rodomas imituotas apmokėjimo langas.
SEB_API_USERNAME=""
SEB_API_SECRET=""
# Apdorojimo sąskaitos pavadinimas, pvz. EUR3D1
SEB_ACCOUNT_NAME=""
# demo -> https://igw-demo.every-pay.com/api | live -> https://pay.every-pay.eu/api
SEB_ENVIRONMENT="demo"
