# Duomenų bazė (SQLite failas projekto kataloge)
DATABASE_URL="file:./dev.db"

# Parduotuvės adresas – naudojamas SEB grąžinimo nuorodoms
APP_URL="http://localhost:3000"

# Pradinio administratoriaus duomenys (naudojami tik `npm run db:seed` metu)
ADMIN_EMAIL="admin@veja.lt"
ADMIN_PASSWORD="Slaptazodis123"

# ---------------------------------------------------------------------------
# SEB banklink (IPIZZA 1.3)
# ---------------------------------------------------------------------------
# mock – vietinis bandomasis bankas (raktai sugeneruojami automatiškai)
# live – tikras SEB bankas
SEB_MODE="mock"

# Iš SEB e. prekybos sutarties
SEB_SND_ID="testvendor"
SEB_REC_ID="SEB"
SEB_PAYMENT_URL="https://e.seb.lt/mainib/site/login.aspx"

# Parašo algoritmas pagal sutartį: sha1 arba sha256
SEB_ALGORITHM="sha1"
SEB_LANG="LIT"

# Raktai: nurodykite arba failo kelią, arba patį PEM tekstą
# SEB_PRIVATE_KEY_PATH="/kelias/iki/pardavejo-privatus.pem"
# SEB_BANK_PUBLIC_KEY_PATH="/kelias/iki/seb-viesasis.pem"
# SEB_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# SEB_BANK_PUBLIC_KEY="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Kai kurie bankai MAC ilgį skaičiuoja baitais, o ne simboliais
SEB_MAC_LENGTH_MODE="chars"
