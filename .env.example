# Duomenų bazė (SQLite lokaliai; gamyboje galima naudoti PostgreSQL)
DATABASE_URL="file:./dev.db"

# Viešas svetainės adresas (naudojamas SEB grąžinimo nuorodoms)
SITE_URL="http://localhost:3000"

# Administratoriaus sesijų slaptažodis (bent 32 atsitiktiniai simboliai)
SESSION_SECRET="pakeiskite-i-ilga-atsitiktine-eilute-min-32-simboliai"

# Pirmasis administratorius (sukuriamas paleidus `npm run db:seed`)
ADMIN_EMAIL="admin@example.lt"
ADMIN_PASSWORD="pakeiskite-slaptazodi"

# SEB e. prekybos mokėjimai (EveryPay API v4)
# SEB_MODE: "mock" (lokalus testavimas be banko), "demo" (SEB testinė aplinka), "live" (tikri mokėjimai)
SEB_MODE="mock"
SEB_API_USERNAME=""
SEB_API_SECRET=""
# Apdorojimo sąskaitos pavadinimas iš SEB prekybininko portalo, pvz. EUR3D1
SEB_ACCOUNT_NAME="EUR3D1"
# Nebūtina: perrašo API adresą (numatytai demo: https://igw-demo.every-pay.com/api/v4)
SEB_API_URL=""

# Nuotraukų saugojimo katalogas
UPLOAD_DIR="./uploads"
